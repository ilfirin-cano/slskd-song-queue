# Exact existing Gluetun container name (check with docker ps)
GLUETUN_CONTAINER=gluetun

# URL/hostname of the already-running slskd container on the Docker network joined by Gluetun
SLSKD_URL=http://slskd:5030


# API key generated in slskd Web/API settings
SLSKD_API_KEY=replace_with_api_key_from_slskd

# Search settings (also configurable for every batch in the web UI)
SEARCH_DURATION_SECONDS=25
SEARCH_WAIT_GRACE_SECONDS=5
DEEP_SEARCH_DURATION_SECONDS=60
DEEP_SEARCH_MIN_MATCH_SCORE=0.50
DEEP_SEARCH_RESPONSE_LIMIT=250
RETRY_NOT_FOUND_BY_DEFAULT=true

# slskd limits concurrent client searches to 2
MAX_PARALLEL_SEARCHES=2
# Search/POST start interval is clamped to at least one second
SEARCH_START_INTERVAL_SECONDS=1

# Match and polling settings
MIN_MATCH_SCORE=0.52
POLL_INTERVAL=1
MAX_RESULTS_PER_SONG=100
SLSKD_429_RETRIES=5
TRANSFER_POLL_INTERVAL=2
TRANSFER_MONITOR_HOURS=24

