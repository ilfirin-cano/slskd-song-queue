# URL/hostname of the already-running slskd container on the shared Docker network
SLSKD_URL=http://slskd:5030

# Existing Docker network used by the slskd container (check with docker inspect)
SLSKD_NETWORK=slskd_default

# API key generated in slskd Web/API settings
SLSKD_API_KEY=replace_with_api_key_from_slskd

# Optional tuning
SEARCH_TIMEOUT_MS=25000
MAX_WAIT_SECONDS=35
MIN_MATCH_SCORE=0.52
POLL_INTERVAL=1
MAX_RESULTS_PER_SONG=100
SLSKD_429_RETRIES=5
TRANSFER_POLL_INTERVAL=2
TRANSFER_MONITOR_HOURS=24
